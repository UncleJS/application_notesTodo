# App
APP_PORT=8080
TZ=UTC

# Database (server connects within the pod at localhost)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=notestodo
DB_USER=notestodo
DB_PASSWORD=__set_me__

# MariaDB container bootstrap
MARIADB_DATABASE=notestodo
MARIADB_USER=notestodo
MARIADB_PASSWORD=__set_me__
MARIADB_ROOT_PASSWORD=__set_me__

# Secrets
SESSION_COOKIE_SECRET=__set_me__
# 64 hex chars (32 bytes) — encrypts SMTP/webhook secrets at rest
SECRETS_ENC_KEY=__set_me__
